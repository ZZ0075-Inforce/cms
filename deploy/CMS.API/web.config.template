<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config for the API site (IIS site "CMS.API", physical path C:\VHome\CMS\API).

  `dotnet publish` generates a web.config of its own; deploy.ps1 OVERWRITES it with this one
  after stamping {{ASPNETCORE_ENVIRONMENT}} and {{CONNECTION_STRING}}. That is the only way to
  inject the <environmentVariables> block without editing the CMS source tree.

  Requires on the IIS server: the ASP.NET Core 9 Hosting Bundle (AspNetCoreModuleV2).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <aspNetCore processPath="dotnet"
                  arguments=".\CMS.API.dll"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <!-- Production. deploy.ps1 stamps this from $aspnetEnv.

               This value is load-bearing for exactly ONE thing: Program.cs registers Swagger only
               under IsDevelopment(), so Production is what keeps the API surface off the network.
               Set this to Development on a deployed box and Swagger goes public again — the guard in
               Program.cs reads THIS variable and nothing else.

               Program.cs has no other environment-conditional logic: no UseHsts, no
               UseHttpsRedirection. Flipping this value cannot 307-redirect the SPA to https, because
               there is no redirect to fire. (An earlier comment here claimed otherwise; it described
               code that never existed, and pinned this to Development to dodge a hazard that was not
               real. Verified 2026-07-17: IsProduction/UseHsts/UseHttpsRedirection appear nowhere in
               src/.) If HTTPS is ever added, add the binding AND the redirect together — do not
               reintroduce an environment pin as a substitute. -->
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="{{ASPNETCORE_ENVIRONMENT}}" />

          <!-- The key is CMS, not DefaultConnection — SqlConnectionFactory does
               configuration.GetConnectionString("CMS"). Double underscore = the ':' separator. -->
          <environmentVariable name="ConnectionStrings__CMS" value="{{CONNECTION_STRING}}" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
